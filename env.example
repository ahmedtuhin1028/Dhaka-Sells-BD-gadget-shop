# ENVIRONMENT VARIABLES
NODE_ENV="development"

# DATABASE (PostgreSQL - Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:5432/dhakasellsbd"

# AUTHENTICATION (Run `openssl rand -base64 32` to generate SECRET)
NEXTAUTH_SECRET="your_super_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# SECURE INITIAL ADMIN CREDENTIALS (Used by Prisma Seed ONLY)
# Never exposed to frontend or APIs directly.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@dhakasellsbd.com"
ADMIN_PASSWORD="SecurePassword123!@#"

# PAYMENT GATEWAYS (Do not expose to frontend)
BKASH_APP_KEY="bkash_app_key_here"
BKASH_APP_SECRET="bkash_app_secret_here"
BKASH_USERNAME="bkash_username"
BKASH_PASSWORD="bkash_password"

SSLCOMMERZ_STORE_ID="dhakasellsbd"
SSLCOMMERZ_STORE_PASSWORD="ssl_password_here"
SSLCOMMERZ_IS_LIVE="false"

# CLOUD STORAGE (For Product Images - e.g., Cloudinary or AWS S3)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
